        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23084"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="pv-scene">
            <objects>
                <viewController id="pv-launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="pv-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <subviews>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="center" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="pv-brand">
                                <rect key="frame" x="138" y="386" width="117" height="104"/>
                                <subviews>
                                    <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="PVMonogram" translatesAutoresizingMaskIntoConstraints="NO" id="pv-mark">
                                        <rect key="frame" x="24.5" y="0.0" width="68" height="68"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="68" id="pv-width"/>
                                            <constraint firstAttribute="height" constant="68" id="pv-height"/>
                                        </constraints>
                                    </imageView>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="PatternVault" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="pv-name">
                                        <rect key="frame" x="0.0" y="80" width="117" height="24"/>
                                        <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="20"/>
                                        <color key="textColor" red="0.090196" green="0.152941" blue="0.239216" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                    </label>
                                </subviews>

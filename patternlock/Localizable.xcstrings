    },
    "Your pattern couldn’t be accessed securely. Unlock your device and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dein Muster konnte nicht sicher zugegriffen werden. Entsperre dein Gerät und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pattern couldn’t be accessed securely. Unlock your device and try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’accéder au schéma en sécurité. Déverrouillez votre appareil et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile accedere al segno in sicurezza. Sblocca il dispositivo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パターンに安全にアクセスできませんでした。デバイスのロックを解除して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패턴에 안전하게 접근하지 못했습니다. 기기의 잠금을 해제하고 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法安全访问图案，请解锁设备后重试。"
          }
        }
      }
    },
    "Your pattern couldn’t be secured. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Muster konnte nicht gesichert werden. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pattern couldn’t be secured. Please try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de sécuriser votre schéma. Réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile proteggere il segno. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パターンを安全に保存できませんでした。再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패턴을 안전하게 저장하지 못했습니다. 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法安全保存图案，请重试。"
          }
        }
      }
    },
    "Your pattern selects a vault. When enabled, Face ID must succeed before its photos and folders appear. The device passcode cannot replace this check." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Muster wählt einen Tresor. Wenn aktiviert, muss Face ID erfolgreich sein, bevor Fotos und Ordner erscheinen. Der Gerätecode kann diese Prüfung nicht ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pattern selects a vault. When enabled, Face ID must succeed before its photos and folders appear. The device passcode cannot replace this check."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre schéma sélectionne un coffre. Une fois activé, Face ID doit réussir avant d’afficher ses photos et dossiers. Le code de l’appareil ne peut pas remplacer ce contrôle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il segno seleziona una cassaforte. Se abilitato, Face ID deve riuscire prima di mostrarne foto e cartelle. Il codice del dispositivo non può sostituire questa verifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パターンで保管庫を選びます。有効な場合はFace ID認証に成功するまで写真やフォルダは表示されません。デバイスのパスコードでは代用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패턴으로 보관함을 선택합니다. 이 기능을 켜면 Face ID 인증에 성공해야 사진과 폴더가 표시됩니다. 기기 암호로 이 인증을 대체할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图案用于选择保险库。启用后，必须通过 Face ID 验证才能显示其中的照片和文件夹。设备密码不能替代此验证。"
          }
        }
      }
    },
    "Your photos, folders, recovery phrases, and Face ID settings stay in place. Nothing changes until every pattern is ready and you save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, Ordner, Wiederherstellungsphrasen und Face-ID-Einstellungen bleiben erhalten. Nichts ändert sich, bis alle Muster bereit sind und du speicherst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your photos, folders, recovery phrases, and Face ID settings stay in place. Nothing changes until every pattern is ready and you save."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos, dossiers, phrases et réglages Face ID sont conservés. Rien ne change avant que tous les schémas soient prêts et enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto, cartelle, frasi e impostazioni Face ID restano. Nulla cambia finché tutti i segni non sono pronti e salvi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真、フォルダ、復旧フレーズ、Face ID設定は保持されます。すべてのパターンが揃って保存するまで変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진, 폴더, 복구 문구 및 Face ID 설정은 유지됩니다. 모든 패턴이 준비되고 저장할 때까지 아무것도 변경되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片、文件夹、恢复短语和 Face ID 设置会保留。在所有图案准备好并保存之前，不会进行任何更改。"
          }
        }
      }
    },
    "Your photos, videos, folders, and vault name are encrypted before saving. Choose iCloud Drive in Files to keep the backup in iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, Videos, Ordner und Tresorname werden vor dem Speichern verschlüsselt. Wähle iCloud Drive in Dateien, um das Backup in iCloud zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your photos, videos, folders, and vault name are encrypted before saving. Choose iCloud Drive in Files to keep the backup in iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos, vidéos, dossiers et nom du coffre sont chiffrés avant l’enregistrement. Choisissez iCloud Drive dans Fichiers pour conserver la sauvegarde dans iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto, video, cartelle e nome della cassaforte sono crittografati prima del salvataggio. Scegli iCloud Drive in File per conservare il backup in iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真、動画、フォルダ、保管庫名は保存前に暗号化されます。iCloudに保存するにはファイルでiCloud Driveを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 전에 사진, 동영상, 폴더 및 보관함 이름을 암호화합니다. iCloud에 백업하려면 파일 앱에서 iCloud Drive를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存前会加密照片、视频、文件夹和保险库名称。请在“文件”中选择 iCloud Drive，将备份保存在 iCloud。"
          }
        }
      }
    },
    "Your purchase is awaiting approval. Unlimited access will unlock when the App Store confirms it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf wartet auf Genehmigung. Unbegrenzter Zugriff wird nach Bestätigung durch den App Store freigeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your purchase is awaiting approval. Unlimited access will unlock when the App Store confirms it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre achat attend une approbation. L’accès illimité sera débloqué après confirmation par l’App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’acquisto è in attesa di approvazione. L’accesso illimitato si sbloccherà alla conferma dell’App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入の承認待ちです。App Storeで確認されると無制限アクセスが有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매 승인 대기 중입니다. App Store에서 확인되면 무제한 이용 권한이 활성화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买正在等待批准。App Store 确认后将解锁无限使用权限。"
          }
        }
      }
    },
    "Your purchase is tied to your Apple Account. Restoring a purchase restores Unlimited access; your photos are restored separately from your saved backup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf ist mit deinem Apple Account verknüpft. Die Kaufwiederherstellung stellt unbegrenzten Zugriff wieder her; Fotos werden separat aus deinem Backup wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your purchase is tied to your Apple Account. Restoring a purchase restores Unlimited access; your photos are restored separately from your saved backup."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’achat est lié à votre compte Apple. Restaurer l’achat rétablit l’accès illimité ; vos photos se restaurent séparément depuis votre sauvegarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’acquisto è legato al tuo Apple Account. Ripristinarlo restituisce l’accesso illimitato; le foto si ripristinano separatamente dal backup salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入はApple Accountに紐付きます。購入の復元で無制限アクセスが戻ります。写真は保存したバックアップから別途復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매는 Apple 계정에 연결됩니다. 구매를 복원하면 무제한 이용 권한이 복원됩니다. 사진은 저장한 백업에서 별도로 복원해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买与你的 Apple 账户关联。恢复购买可恢复无限使用权限；照片须从已保存的备份中单独恢复。"
          }
        }
      }
    },

    "Revocation is pending. Pattern will retry when it can reach iCloud." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriffsentzug steht aus. Pattern versucht es erneut, sobald iCloud erreichbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revocation is pending. Pattern will retry when it can reach iCloud."
          }
        },

          }
        }
      }
    },
    "Revocation takes effect when iCloud receives it. Copies already saved outside Pattern cannot be removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Entzug wird wirksam, sobald iCloud ihn erhält. Bereits außerhalb von Pattern gespeicherte Kopien können nicht gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revocation takes effect when iCloud receives it. Copies already saved outside Pattern cannot be removed."
          }
        },
        "fr" : {
          "stringUnit" : {

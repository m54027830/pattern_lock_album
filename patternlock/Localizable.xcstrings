    "Delete “%@” and all its files (%lld), its pattern, and its recovery phrase from this device. Other vaults and originals in Photos stay. Backups saved in Files must be deleted separately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht „%@“, alle Dateien (%lld), das Muster und die Wiederherstellungsphrase von diesem Gerät. Andere Tresore und Originale in Fotos bleiben. Backups in Dateien müssen separat gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete “%@” and all its files (%lld), its pattern, and its recovery phrase from this device. Other vaults and originals in Photos stay. Backups saved in Files must be deleted separately."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime « %@ », tous ses fichiers (%lld), son schéma et sa phrase de cet appareil. Les autres coffres et originaux dans Photos restent. Supprimez séparément les sauvegardes dans Fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina “%@”, tutti i suoi file (%lld), il segno e la frase di recupero da questo dispositivo. Altre casseforti e originali in Foto restano. I backup in File vanno eliminati separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから「%@」とすべてのファイル（%lld件）、パターン、復旧フレーズを削除します。他の保管庫と写真アプリのオリジナルは残ります。ファイルに保存したバックアップは別途削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 “%@” 및 모든 파일(%lld개), 패턴, 복구 문구를 삭제합니다. 다른 보관함과 사진 앱의 원본은 유지됩니다. 파일 앱에 저장한 백업은 별도로 삭제해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此设备删除“%@”及其所有文件（%lld 个）、图案和恢复短语。其他保险库及“照片”中的原件会保留。“文件”中的备份须另行删除。"
          }
        }
      }
    },

    },
    "Deleting Pattern removes your local vaults. Enable encrypted iCloud backup in settings to restore after reinstalling." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Pattern löschst, werden lokale Tresore entfernt. Aktiviere das verschlüsselte iCloud-Backup in den Einstellungen, um sie nach einer Neuinstallation wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting Pattern removes your local vaults. Enable encrypted iCloud backup in settings to restore after reinstalling."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer Pattern efface les coffres locaux. Activez la sauvegarde iCloud chiffrée dans les réglages pour les restaurer après réinstallation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminando Pattern rimuovi le casseforti locali. Abilita il backup iCloud crittografato nelle impostazioni per ripristinarle dopo la reinstallazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patternを削除すると端末内の保管庫も削除されます。再インストール後に復元するには、設定で暗号化iCloudバックアップを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattern을 삭제하면 로컬 보관함도 삭제됩니다. 재설치 후 복원하려면 설정에서 암호화된 iCloud 백업을 켜세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 Pattern 会清除本地保险库。请在设置中启用加密 iCloud 备份，以便重新安装后恢复。"
          }
        }
      }
    },
    "Deleting Pattern removes your local vaults. Save an encrypted backup to iCloud Drive in settings so you can restore after reinstalling." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Löschen von Pattern werden lokale Tresore entfernt. Sichere in den Einstellungen ein verschlüsseltes Backup in iCloud Drive zur Wiederherstellung nach einer Neuinstallation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting Pattern removes your local vaults. Save an encrypted backup to iCloud Drive in settings so you can restore after reinstalling."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer Pattern efface les coffres locaux. Enregistrez une sauvegarde chiffrée sur iCloud Drive dans les réglages pour restaurer après réinstallation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminando Pattern rimuovi le casseforti locali. Salva un backup crittografato su iCloud Drive nelle impostazioni per ripristinarle dopo la reinstallazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patternを削除するとローカルの保管庫も削除されます。再インストール後に復元できるよう、設定で暗号化バックアップをiCloud Driveに保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattern을 삭제하면 로컬 보관함도 삭제됩니다. 재설치 후 복원하려면 설정에서 iCloud Drive에 암호화된 백업을 저장하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 Pattern 会移除本地保险库。请在设置中将加密备份保存到 iCloud Drive，以便重新安装后恢复。"
          }
        }
      }
    },

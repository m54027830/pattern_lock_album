    "Delete this vault’s iCloud backup?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iCloud-Backup dieses Tresors löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete this vault’s iCloud backup?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer la sauvegarde iCloud de ce coffre ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare il backup iCloud di questa cassaforte?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この保管庫のiCloudバックアップを削除しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보관함의 iCloud 백업을 삭제할까요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除此保险库的 iCloud 备份？"
          }
        }
      }
    },
    "Deletes local files and credentials. For an owned vault, its configured cloud backup and shares are also removed when iCloud is available. Other vaults, Photos originals, and exported backup files remain." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht lokale Dateien und Zugangsdaten. Bei eigenen Tresoren werden auch das eingerichtete Cloud-Backup und Freigaben gelöscht, sobald iCloud erreichbar ist. Andere Tresore, Fotos-Originale und exportierte Backups bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes local files and credentials. For an owned vault, its configured cloud backup and shares are also removed when iCloud is available. Other vaults, Photos originals, and exported backup files remain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les fichiers et identifiants locaux. Pour vos coffres, la sauvegarde cloud configurée et les partages sont aussi supprimés dès qu’iCloud est accessible. Les autres coffres, originaux Photos et sauvegardes exportées restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina file e credenziali locali. Per le casseforti di tua proprietà, rimuove anche il backup cloud configurato e le condivisioni quando iCloud è disponibile. Restano le altre casseforti, gli originali in Foto e i backup esportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末内のファイルと認証情報を削除します。所有する保管庫では、設定済みのクラウドバックアップと共有もiCloud接続時に削除します。他の保管庫、写真アプリのオリジナル、書き出したバックアップは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 파일과 인증 정보를 삭제합니다. 소유한 보관함의 설정된 클라우드 백업과 공유도 iCloud 연결 시 제거합니다. 다른 보관함, 사진 앱 원본, 내보낸 백업 파일은 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除本地文件和凭据。如果是你拥有的保险库，iCloud 可用时还会删除已配置的云备份和共享。其他保险库、照片原件和导出的备份文件会保留。"
          }
        }
      }
    },
    "Deletes this vault’s local files and access credentials. Other vaults, Photos originals, and saved backup files remain." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht lokale Dateien und Zugangsdaten dieses Tresors. Andere Tresore, Fotooriginale und gespeicherte Backups bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes this vault’s local files and access credentials. Other vaults, Photos originals, and saved backup files remain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les fichiers locaux et les identifiants de ce coffre. Les autres coffres, originaux dans Photos et sauvegardes sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina file locali e credenziali di questa cassaforte. Altre casseforti, originali in Foto e backup salvati restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この保管庫のローカルファイルと認証情報を削除します。他の保管庫、写真のオリジナル、保存済みバックアップは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보관함의 로컬 파일과 접근 자격 증명을 삭제합니다. 다른 보관함, 사진 앱 원본, 저장된 백업은 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除此保险库的本地文件和访问凭据。其他保险库、“照片”原件和已保存的备份会保留。"
          }
        }
      }
    },
    "Deleting originals from Photos…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originale werden aus Fotos gelöscht…"
          }
        },
        "en" : {

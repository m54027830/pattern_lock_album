            "state" : "translated",
            "value" : "Mode contrainte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coercizione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強要対策モード"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

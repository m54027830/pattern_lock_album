    "Enable automatic encrypted backup separately for each vault. Restore directly from iCloud after reinstalling." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere das automatische verschlüsselte Backup für jeden Tresor einzeln. Nach einer Neuinstallation kannst du direkt aus iCloud wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable automatic encrypted backup separately for each vault. Restore directly from iCloud after reinstalling."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la sauvegarde automatique chiffrée pour chaque coffre. Restaurez directement depuis iCloud après réinstallation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita il backup automatico crittografato per ogni cassaforte. Dopo la reinstallazione, ripristina direttamente da iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫ごとに暗号化自動バックアップを有効にできます。再インストール後はiCloudから直接復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함마다 암호화된 자동 백업을 켤 수 있습니다. 재설치 후 iCloud에서 바로 복원하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个保险库分别启用自动加密备份。重新安装后可直接从 iCloud 恢复。"

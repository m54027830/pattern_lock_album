    "This shared vault is unavailable. It may have been claimed by another Apple Account or revoked by its owner." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser geteilte Tresor ist nicht verfügbar. Vielleicht wurde er von einem anderen Apple Account beansprucht oder der Eigentümer hat den Zugriff entzogen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This shared vault is unavailable. It may have been claimed by another Apple Account or revoked by its owner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce coffre partagé est indisponible. Un autre compte Apple l’a peut-être réclamé, ou le propriétaire a révoqué l’accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa cassaforte condivisa non è disponibile. Potrebbe essere stata riscattata da un altro Apple Account o revocata dal proprietario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この共有保管庫は利用できません。別のApple Accountで受け取られたか、所有者がアクセスを取り消した可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 공유 보관함을 사용할 수 없습니다. 다른 Apple 계정이 수락했거나 소유자가 접근을 취소했을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此共享保险库不可用。可能已被其他 Apple 账户领取，或所有者已撤销访问权限。"
          }
        }
      }
    },
    "This sharing phrase couldn’t be opened. Check every word and ask the owner whether access is still available." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Freigabephrase konnte nicht geöffnet werden. Prüfe jedes Wort und frage den Eigentümer, ob der Zugriff noch verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sharing phrase couldn’t be opened. Check every word and ask the owner whether access is still available."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette phrase de partage n’a pas pu être ouverte. Vérifiez chaque mot et demandez au propriétaire si l’accès est toujours disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire questa frase di condivisione. Controlla ogni parola e chiedi al proprietario se l’accesso è ancora disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この共有フレーズを確認できませんでした。各単語を確認し、所有者にアクセスが有効か問い合わせてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 문구를 확인할 수 없습니다. 모든 단어를 확인하고 소유자에게 접근이 아직 가능한지 문의하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法使用此共享短语。请检查每个词，并询问所有者是否仍可访问。"
          }
        }
      }
    },
    "This stops future duress actions. It won’t restore access already removed or turn backups back on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies stoppt künftige Zwangsaktionen. Entfernte Zugriffe werden nicht wiederhergestellt und Backups nicht wieder aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This stops future duress actions. It won’t restore access already removed or turn backups back on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela arrête les futures actions de contrainte. Les accès retirés ne sont pas restaurés et les sauvegardes ne sont pas réactivées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma le future azioni di coercizione. Non ripristina accessi rimossi né riattiva i backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後の強要時の処理を停止します。削除済みのアクセスを復元したり、バックアップを再開したりはしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이후의 강압 대응 모드 실행을 중지합니다. 이미 제거된 접근 권한을 복원하거나 백업을 다시 켜지는 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会停止今后的胁迫操作，但不会恢复已移除的访问，也不会重新开启备份。"
          }
        }
      }
    },

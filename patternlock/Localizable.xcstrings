    "Confirm this vault’s pattern to enable duress. The next time you use it to unlock Pattern, the actions above will happen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige das Muster dieses Tresors für den Zwangsmodus. Wenn du Pattern das nächste Mal damit entsperrst, werden die obigen Aktionen ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm this vault’s pattern to enable duress. The next time you use it to unlock Pattern, the actions above will happen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez le schéma de ce coffre pour activer le mode contrainte. À son prochain déverrouillage de Pattern, les actions ci-dessus seront exécutées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma il segno per abilitare la modalità coercizione. Al prossimo sblocco di Pattern con questo segno verranno eseguite le azioni sopra indicate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この保管庫のパターンを確認して強要対策モードを有効にします。次にこのパターンでPatternを解除すると、上記の処理が実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강압 대응 모드를 켜려면 이 보관함의 패턴을 확인하세요. 다음에 이 패턴으로 Pattern의 잠금을 해제하면 위의 작업이 실행됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认此保险库的图案以启用胁迫模式。下次使用该图案解锁 Pattern 时，将执行上述操作。"
          }
        }
      }
    },

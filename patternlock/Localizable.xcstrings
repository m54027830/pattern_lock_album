    "Replacing the phrase disables the old phrase for this vault. Existing backup files still require the phrase used when they were created. Make a new backup after changing it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Phrase deaktiviert die alte für diesen Tresor. Bestehende Backups benötigen weiterhin die ursprüngliche Phrase. Erstelle nach der Änderung ein neues Backup."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replacing the phrase disables the old phrase for this vault. Existing backup files still require the phrase used when they were created. Make a new backup after changing it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer la phrase désactive l’ancienne pour ce coffre. Les sauvegardes existantes exigent encore leur phrase d’origine. Créez une nouvelle sauvegarde après modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituire la frase disabilita quella vecchia per questa cassaforte. I backup esistenti richiedono ancora la frase originale. Crea un nuovo backup dopo la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレーズを変更すると、この保管庫では古いフレーズが無効になります。既存のバックアップには作成時のフレーズが必要です。変更後は新しいバックアップを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문구를 교체하면 이 보관함에서 이전 문구를 사용할 수 없습니다. 기존 백업 파일에는 생성 당시 사용한 문구가 필요합니다. 변경 후 새 백업을 만드세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更换短语后，此保险库的旧短语将失效。现有备份仍需要创建时使用的短语。更改后请创建新备份。"
          }
        }
      }
    },

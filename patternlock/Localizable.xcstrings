        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패턴 입력 후 Face ID를 추가하고 인증 실패 시 표시할 보관함을 선택하세요. Face ID 실패로 강압 대응 모드가 실행되지는 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

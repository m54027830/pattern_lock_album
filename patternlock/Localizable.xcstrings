    "Each pattern opens its own vault, with separate photos, videos, and folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Muster öffnet einen eigenen Tresor mit getrennten Fotos, Videos und Ordnern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each pattern opens its own vault, with separate photos, videos, and folders."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque schéma ouvre son propre coffre, avec des photos, vidéos et dossiers séparés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni segno apre la propria cassaforte, con foto, video e cartelle separati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各パターンで、写真・動画・フォルダが分かれた専用の保管庫が開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 패턴은 사진, 동영상, 폴더가 분리된 별도의 보관함을 엽니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个图案打开独立的保险库，各自拥有照片、视频和文件夹。"
          }
        }
      }
    },
    "Each pattern opens one album. Folders share that album’s photo and video limit. All privacy features are included in the free version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Muster öffnet ein Album. Ordner teilen dessen Foto- und Videolimit. Alle Datenschutzfunktionen sind kostenlos enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each pattern opens one album. Folders share that album’s photo and video limit. All privacy features are included in the free version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque schéma ouvre un album. Les dossiers partagent sa limite de photos et vidéos. Toutes les fonctions de confidentialité sont gratuites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni segno apre un album. Le cartelle condividono il suo limite di foto e video. Tutte le funzioni di privacy sono gratuite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各パターンで1つのアルバムが開きます。フォルダも同じアルバムの写真・動画の上限を共有します。プライバシー機能はすべて無料です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 패턴은 하나의 앨범을 엽니다. 폴더는 앨범의 사진 및 동영상 한도를 공유합니다. 모든 개인정보 보호 기능은 무료 버전에 포함됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个图案打开一个相册。文件夹共享该相册的照片和视频额度。免费版包含全部隐私功能。"
          }
        }
      }

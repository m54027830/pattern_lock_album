        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez Face ID après le schéma et choisissez le coffre à afficher en cas d’échec. Un échec de Face ID n’active jamais le mode contrainte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

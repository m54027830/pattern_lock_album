    "Enter a sharing phrase from someone you trust." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Freigabephrase einer Person ein, der du vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a sharing phrase from someone you trust."
          }
        },

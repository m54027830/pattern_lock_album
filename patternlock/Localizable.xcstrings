          "stringUnit" : {
            "state" : "translated",
            "value" : "The photos and videos inside will stay in All media."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos et vidéos qu’il contient resteront dans Tous les médias."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto e i video all’interno resteranno in Tutti i contenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中の写真や動画は「すべてのメディア」に残ります。"

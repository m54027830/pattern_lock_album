          }
        }
      }
    },
    "The phrase won’t be shown again after setup. Keep it to reset a forgotten pattern or open an iCloud backup. A phrase alone cannot restore photos after deleting the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Phrase wird nach der Einrichtung nicht erneut angezeigt. Bewahre sie zum Zurücksetzen vergessener Muster oder Öffnen von iCloud-Backups auf. Die Phrase allein kann nach dem Löschen der App keine Fotos wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phrase won’t be shown again after setup. Keep it to reset a forgotten pattern or open an iCloud backup. A phrase alone cannot restore photos after deleting the app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La phrase ne sera plus affichée après la configuration. Conservez-la pour réinitialiser un schéma oublié ou ouvrir une sauvegarde iCloud. Elle seule ne peut pas restaurer les photos après suppression de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frase non verrà mostrata dopo la configurazione. Conservala per reimpostare il segno o aprire un backup iCloud. Da sola non può ripristinare foto dopo aver eliminato l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定後はフレーズを再表示できません。忘れたパターンのリセットやiCloudバックアップを開くために保管してください。アプリ削除後、フレーズだけでは写真を復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 후에는 문구가 다시 표시되지 않습니다. 잊어버린 패턴을 재설정하거나 iCloud 백업을 열 수 있도록 보관하세요. 앱 삭제 후에는 문구만으로 사진을 복원할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置完成后不会再次显示短语。请保留它，以便重设忘记的图案或打开 iCloud 备份。删除应用后，仅凭短语无法恢复照片。"
          }
        }
      }
    },
    "The purchase is currently unavailable. Try again when the App Store is available." : {

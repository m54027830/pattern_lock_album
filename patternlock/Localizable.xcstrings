    "Creating shares requires Pattern Unlimited. Opening a shared vault is free. Each phrase can be claimed by one Apple Account. Create a separate phrase for each person." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Teilen brauchst du Pattern Unlimited. Geteilte Tresore zu öffnen ist kostenlos. Jede Phrase kann von einem Apple Account beansprucht werden. Erstelle für jede Person eine eigene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creating shares requires Pattern Unlimited. Opening a shared vault is free. Each phrase can be claimed by one Apple Account. Create a separate phrase for each person."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattern Unlimited est nécessaire pour créer un partage. L’ouverture est gratuite. Chaque phrase est réservée à un seul compte Apple. Créez une phrase par personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per creare condivisioni serve Pattern Unlimited. Aprirle è gratuito. Ogni frase può essere riscattata da un solo Apple Account. Creane una per ogni persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有の作成にはPattern Unlimitedが必要です。共有保管庫を開くのは無料です。各フレーズは1つのApple Accountでのみ受け取れます。相手ごとに作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 생성에는 Pattern Unlimited가 필요합니다. 공유 보관함 열기는 무료입니다. 각 문구는 하나의 Apple 계정만 사용할 수 있습니다. 사람마다 별도 문구를 만드세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建共享需要 Pattern Unlimited，打开共享保险库则免费。每个短语仅供一个 Apple 账户领取。请为每位接收者创建独立短语。"
          }
        }
      }
    },

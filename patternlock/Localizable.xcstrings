            "value" : "Les photos silencieuses ne sont pas prises en charge sur cet appareil. Utilisez Photo ou Vidéo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non supporta le foto silenziose. Usa Foto o Video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは無音写真に対応していません。写真またはビデオを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {

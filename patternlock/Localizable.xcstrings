          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真、ビデオ、メモ、書類を保管庫に保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진, 동영상, 메모, 문서를 보관함에 보관하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将照片、视频、备忘录和文档保存在保险库中。"
          }
        }
      }
    },
    "Keep this phrase somewhere safe outside Pattern. Anyone with it can reset this vault’s pattern and open backups made with it. Custom phrases are only as strong as the words you choose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre die Phrase sicher außerhalb von Pattern auf. Wer sie kennt, kann das Muster zurücksetzen und damit erstellte Backups öffnen. Eigene Phrasen sind nur so sicher wie ihre Wörter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this phrase somewhere safe outside Pattern. Anyone with it can reset this vault’s pattern and open backups made with it. Custom phrases are only as strong as the words you choose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez cette phrase en lieu sûr hors de Pattern. Quiconque la possède peut réinitialiser ce schéma et ouvrir ses sauvegardes. La solidité d’une phrase personnalisée dépend des mots choisis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la frase al sicuro fuori da Pattern. Chi la possiede può reimpostare il segno e aprire i backup creati con essa. La sicurezza delle frasi personalizzate dipende dalle parole scelte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレーズはPatternの外で安全に保管してください。持っている人はこの保管庫のパターンをリセットし、このフレーズで作ったバックアップを開けます。カスタムフレーズの強さは選んだ単語次第です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문구를 Pattern 외부의 안전한 곳에 보관하세요. 문구를 가진 사람은 이 보관함의 패턴을 재설정하고 해당 문구로 만든 백업을 열 수 있습니다. 사용자 지정 문구의 보안 강도는 선택한 단어에 달려 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将此短语保存在 Pattern 之外的安全位置。任何持有短语的人都能重设此保险库的图案并打开用它创建的备份。自定义短语的安全性取决于所选的词。"
          }
        }
      }
    },

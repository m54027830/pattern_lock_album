      }
    },
    "Enter the sharing phrase from the vault’s owner. This is different from a recovery phrase. Claiming ties the invitation to your current Apple Account." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Freigabephrase des Eigentümers ein. Sie ist keine Wiederherstellungsphrase. Beim Annehmen wird die Einladung mit deinem aktuellen Apple Account verknüpft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the sharing phrase from the vault’s owner. This is different from a recovery phrase. Claiming ties the invitation to your current Apple Account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez la phrase de partage du propriétaire, différente d’une phrase de récupération. L’acceptation lie l’invitation à votre compte Apple actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la frase di condivisione del proprietario, diversa da quella di recupero. Accettando, colleghi l’invito al tuo Apple Account attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有者から受け取った共有フレーズを入力してください。復元フレーズとは異なります。受け取ると、このApple Accountに招待が紐付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소유자가 준 공유 문구를 입력하세요. 복구 문구와 다릅니다. 수락하면 초대가 현재 Apple 계정에 연결됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入所有者提供的共享短语，它与恢复短语不同。领取后，邀请将绑定到当前 Apple 账户。"
          }
        }
      }
    },

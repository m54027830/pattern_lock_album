        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず復旧フレーズを設定してください。このアプリの外で安全に保管しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 복구 문구를 설정하세요. 앱 외부의 안전한 곳에 보관하세요."

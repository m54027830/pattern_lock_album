    "This replaces this vault’s previous recovery phrase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ersetzt die bisherige Wiederherstellungsphrase dieses Tresors."

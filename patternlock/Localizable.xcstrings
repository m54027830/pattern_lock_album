            "state" : "translated",
            "value" : "Saved only to this vault, never to Photos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré uniquement dans ce coffre, jamais dans Photos."
